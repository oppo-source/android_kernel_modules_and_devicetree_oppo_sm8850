load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")
load("@mgk_info//:kernel_version.bzl", "kernel_version")
load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")
load("//build/kernel/oplus:oplus_modules_dist.bzl", "ddk_copy_to_dist_dir")


package(
    default_visibility = [
        "//visibility:public",
    ],
)

define_mgk_ddk_ko(
    name = "oplus_data_record",
    srcs = ["data_record.c"],
    hdrs = glob(["**/*.h"]),
    copts = [
	"-I$(DEVICE_MODULES_PATH)/drivers/misc/mediatek/scp/include",
	"-I$(DEVICE_MODULES_PATH)/drivers/misc/mediatek/scp/rv",
	"-I$(DEVICE_MODULES_PATH)/drivers/misc/mediatek/sensor/2.0/sensorhub",
    "-I$(DEVICE_MODULES_PATH)/drivers/misc/mediatek/sensor/2.0/core",
    ],
    header_deps = [
        "//kernel_device_modules-{}/drivers/misc/mediatek/scp/include:scp_public_headers".format(kernel_version),
        "//kernel_device_modules-{}/drivers/misc/mediatek/sensor/2.0/sensorhub:ddk_public_headers".format(kernel_version),
    ],
    ko_deps = [
        "//kernel_device_modules-{}/drivers/misc/mediatek/sensor/2.0/sensorhub:sensorhub".format(kernel_version),
        "//kernel_device_modules-{}/drivers/misc/mediatek/sensor/2.0/core:hf_manager".format(kernel_version),
        "//kernel_device_modules-{}/drivers/misc/mediatek/scp/rv:scp".format(kernel_version),
    ],

    includes = ["."],
)

filegroup(
    name = "ddk_kconfigs",
    srcs = glob([
        "**/Kconfig",
    ]),
)

filegroup(
    name = "srcs",
    srcs = glob([
        "**/Makefile",
        "**/Kbuild",
        "**/*.c",
        "**/*.h",
    ]),
)

ddk_headers(
    name = "oplus_data_record_headers",
    includes = ["."],
    hdrs = glob(["**/*.h"]),
    linux_includes = ["include"],
)
ddk_copy_to_dist_dir(
    name = "oplus_data_record",
    module_list = [
        "oplus_data_record",
    ],
)
