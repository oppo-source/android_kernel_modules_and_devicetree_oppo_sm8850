#include <dt-bindings/msm-camera.h>
#include "ftm_camera_settings.dtsi"
#include <dt-bindings/iio/qcom,spmi-vadc.h>
#include <dt-bindings/iio/qcom,spmi-adc5-gen4-pmk8850.h>
#define PMK8850_SID  0

&qupv3_se22_i2c {
 	status = "ok";
 	qcom,clk-freq-out = <1000000>;
 	tof8806: tof8806@41 {
 		reg = <0x41>;
 		tof,tof_poll_period = <0xA>; /*poll period (100 usec)*/
 		compatible = "ams,tof8806";
 		enable-gpios = <&pmh0110_d_gpios 12 0>;
 		status = "ok";
 	};
 };

&qupv3_se22_i2c_sda_active {
	mux {
		pins = "gpio121";
		function = "qup4_se3_l0";
	};

	config {
		pins = "gpio121";
		drive-strength = <4>;
		bias-pull-up;
		qcom,i2c_pull;
	};
};

&qupv3_se22_i2c_scl_active {
	mux {
		pins = "gpio84";
		function = "qup4_se3_l1";
	};

	config {
		pins = "gpio84";
		drive-strength = <4>;
		bias-pull-up;
		qcom,i2c_pull;
	};
};

&qupv3_se22_i2c_sleep {
	mux {
		pins = "gpio121", "gpio84";
		function = "gpio";
	};

	config {
		pins = "gpio121", "gpio84";
		drive-strength = <4>;
	};
};

&qupv3_se9_i2c_sda_active {
	mux {
		pins = "gpio4";
		function = "qup2_se1_l0";
	};

	config {
		pins = "gpio4";
		drive-strength = <4>;
		/* qcom,i2c_pull; oplus remove*/
		qcom,apps;
	};
};

&qupv3_se9_i2c_scl_active {
	mux {
		pins = "gpio5";
		function = "qup2_se1_l1";
	};

	config {
		pins = "gpio5";
		drive-strength = <4>;
		/* qcom,i2c_pull; oplus remove*/
		qcom,apps;
	};
};

&L16B {
	regulator-min-microvolt = <3000000>;
	regulator-max-microvolt = <3000000>;
	qcom,init-voltage = <3000000>;
};

&L1M {
	regulator-min-microvolt = <1100000>;
	regulator-max-microvolt = <1100000>;
	qcom,init-voltage = <1100000>;
};

&L2M {
	regulator-min-microvolt = <1100000>;
	regulator-max-microvolt = <1100000>;
	qcom,init-voltage = <1100000>;
};

&L4M {
	regulator-min-microvolt = <2800000>;
	regulator-max-microvolt = <2800000>;
	qcom,init-voltage = <2800000>;
};

&L5M {
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
	qcom,init-voltage = <1800000>;
};

&L6M {
	regulator-min-microvolt = <2800000>;
	regulator-max-microvolt = <2800000>;
	qcom,init-voltage = <2800000>;
};

&L7M {
	regulator-min-microvolt = <3500000>;
	regulator-max-microvolt = <3500000>;
	qcom,init-voltage = <3500000>;
};

&L2N {
	regulator-min-microvolt = <820000>;
	regulator-max-microvolt = <820000>;
	qcom,init-voltage = <820000>;
};

&L6N {
	regulator-min-microvolt = <2200000>;
	regulator-max-microvolt = <2200000>;
	qcom,init-voltage = <2200000>;
};

&L7N {
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	qcom,init-voltage = <3300000>;
};

&L1F {
	regulator-min-microvolt = <1000000>;
	regulator-max-microvolt = <1000000>;
	qcom,init-voltage = <1000000>;
};

&cam_sensor_mclk2_active {
	/* MCLK2 */
	mux {
		pins = "gpio91";
		function = "cam_asc_mclk2";
	};

	config {
		pins = "gpio91";
		bias-disable; /* No PULL */
		drive-strength = <2>; /* 2 MA */
	};
};

&cam_sensor_mclk2_suspend {
	/* MCLK2 */
	mux {
		pins = "gpio91";
		function = "cam_asc_mclk2";
	};

	config {
		pins = "gpio91";
		bias-pull-down; /* PULL DOWN */
		drive-strength = <2>; /* 2 MA */
	};
};

&cam_sensor_mclk3_active {
	/* MCLK3 */
