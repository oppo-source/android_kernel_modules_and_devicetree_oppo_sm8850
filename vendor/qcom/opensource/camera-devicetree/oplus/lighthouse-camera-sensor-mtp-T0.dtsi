		rgltr-min-voltage = <1800000 820000 2800000 1800000 0>;
		rgltr-max-voltage = <1800000 820000 2800000 1800000 0>;
		rgltr-load-current = <6000 12000 50000 3000 0>;
		gpio-no-mux = <0>;
		pinctrl-names = "cam_default", "cam_suspend";
