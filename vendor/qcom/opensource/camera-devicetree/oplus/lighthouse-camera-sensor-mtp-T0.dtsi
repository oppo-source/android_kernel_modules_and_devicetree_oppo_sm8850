		cam_vio-supply = <&L5M>;
		cam_vdig-supply = <&L1F>;
		cam_vana-supply = <&L6M>;
		cam_vaf-supply = <&L7N>;
		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
		regulator-names = "cam_vio", "cam_vdig", "cam_clk","cam_vana",
			"cam_vaf";
		rgltr-cntrl-support;
		rgltr-min-voltage = <1800000 1000000 0 2200000 3300000>;
		rgltr-max-voltage = <1800000 1000000 0 2200000 3300000>;
		rgltr-load-current = <600000 1200000 0 300000 15000>;
		cci-master = <CCI_MASTER_1>;
		status = "ok";
	};

	actuator_utele: qcom,actuator4 {
		cell-index = <4>;
		compatible = "qcom,actuator";
		cci-master = <CCI_MASTER_1>;
		cam_vio-supply = <&L5M>;
		cam_vdig-supply = <&L1F>;
		cam_vana-supply = <&L6N>;
		cam_vaf-supply = <&L7N>;
		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
		regulator-names = "cam_vio", "cam_vdig", "cam_clk","cam_vana",
			"cam_vaf";
		rgltr-cntrl-support;
		rgltr-min-voltage = <1800000 1000000 0 2200000 3300000>;
		rgltr-max-voltage = <1800000 1000000 0 2200000 3300000>;
		rgltr-load-current = <600000 1200000 0 300000 15000>;
		is_update_pid;
		actuator,name = "dw9827c";
		status = "ok";
	};

	ois_utele: qcom,ois2 {
		cell-index = <4>;
		compatible = "qcom,ois";
		cci-master = <CCI_MASTER_1>;
		cam_vio-supply = <&L5M>;
		cam_vdig-supply = <&L1F>;
		cam_vana-supply = <&L6N>;
		cam_vaf-supply = <&L7N>;
		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
		regulator-names = "cam_vio", "cam_vdig", "cam_clk","cam_vana",
			"cam_vaf";
		rgltr-cntrl-support;
		rgltr-min-voltage = <1800000 1000000 0 2200000 3300000>;
		rgltr-max-voltage = <1800000 1000000 0 2200000 3300000>;
		rgltr-load-current = <600000 1200000 0 300000 15000>;
		// ois_gyro,position=<3>;
		// ois_gyro,type=<0>;
		// ois,type=<1>;
		// ois,name="sem1217s";
		// ois_module,vendor=<0>;
		// ois_actuator,vednor=<7>;
		// ois,fw=<1>;
		// download,fw=<1>;
		// ois_eis_function = <6>;
		// actuator_ois_eeprom_merge = <1>;
		status = "ok";
	};

	//utele sensor
	qcom,cam-sensor4 {
		cell-index = <4>;
		compatible = "qcom,cam-sensor";
		csiphy-sd-index = <5>;
		sensor-position-roll = <90>;
		sensor-position-pitch = <0>;
		sensor-position-yaw = <180>;
		eeprom-src = <&eeprom_utele>;
		ois-src = <&ois_utele>;
		actuator-src = <&actuator_utele>;
		led-flash-src = <&led_flash_triple_rear_utele>;
		cam_vio-supply = <&L5M>;
		cam_vdig-supply = <&L1F>;
		cam_vana-supply = <&L6N>;
		cam_vaf-supply = <&L7N>;
		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
		regulator-names = "cam_vio", "cam_vdig", "cam_clk","cam_vana",
			"cam_vaf";
		rgltr-cntrl-support;
		rgltr-min-voltage = <1800000 1000000 0 2200000 3300000>;
		rgltr-max-voltage = <1800000 1000000 0 2200000 3300000>;
		rgltr-load-current = <600000 1200000 0 300000 15000>;
		gpio-no-mux = <0>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_sensor_mclk2_active
				 &cam_sensor_active_rst_utele>;
		pinctrl-1 = <&cam_sensor_mclk2_suspend
				 &cam_sensor_suspend_rst_utele>;
		gpios = <&tlmm 91 0>,
			<&pmh0110_f_gpios 11 0>;
		gpio-reset = <1>;
		gpio-req-tbl-num = <0 1>;
		gpio-req-tbl-flags = <1 0>;
		gpio-req-tbl-label = "CAMIF_MCLK2",
					"CAM_RESET2";
		cci-master = <CCI_MASTER_1>;
		clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK2_CLK>;
		clock-names = "cam_clk";
		clock-cntl-level = "nominal";
		clock-rates = <19200000>;
		//ftm_setting_compatible = <'W' 0xFCFC 2 2 0x4000  'R' 0x0000 2 2 0x38E5>;
		status = "ok";
	};

	//multispectral sensor
	qcom,cam-sensor5 {
		cell-index = <5>;
		compatible = "qcom,cam-sensor";
		csiphy-sd-index = <0>;
		sensor-position-roll = <90>;
		sensor-position-pitch = <0>;
		sensor-position-yaw = <180>;
		cam_vana-supply = <&L5N>;
		cam_vdig-supply = <&L1M>;
		cam_vio-supply = <&L5M>;
		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
		regulator-names = "cam_vana", "cam_vdig", "cam_clk", "cam_vio";
		rgltr-cntrl-support;
		rgltr-min-voltage = <2800000 1100000 0 1800000>;
		rgltr-max-voltage = <2800000 1100000 0 1800000>;
		rgltr-load-current = <300000 12000 0 300000>;
		gpio-no-mux = <0>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_sensor_multispectral_mclk1_active
				 &cam_sensor_active_rst_multispectral>;
		pinctrl-1 = <&cam_sensor_multispectral_mclk1_suspend
				 &cam_sensor_suspend_rst_multispectral>;
		gpios = <&tlmm 94 0>,
			<&pmh0110_f_gpios 12 0>;
		gpio-reset = <1>;
		gpio-req-tbl-num = <0 1>;
		gpio-req-tbl-flags = <1 0>;
		gpio-req-tbl-label =  "CAMIF_MCLK5",
					"CAM_RESET5";
		cci-master = <CCI_MASTER_0>;
		clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK5_CLK>;
		clock-names = "cam_clk";
		clock-cntl-level = "nominal";
		clock-rates = <24000000>;
		need-write-probe-register;
		//                       reg_addr   addr_type   reg_data    data_type   delay       data_mask
		probe-reg-setting = < 0xfd         1           0x00          1           100        0x00
							  0xfd         1           0x00          1           100        0x00
							  0x20         1           0x00          1           2000       0x00 >;
		//ftm_setting_compatible = <'R' 0x03 1 1 0x56>; //expect camera_0003_0056
		reg_otp_compatible = <'W' 0xFD 1 1 0x00 0
		                      'W' 0x20 1 1 0x00 0
		                      'W' 0xFD 1 1 0x10 0
		                      'W' 0x01 1 1 0x04 0
		                      'W' 0xFD 1 1 0x03 0
		                      'W' 0x86 1 1 0x00 0
		                      'W' 0xB7 1 1 0x80 0
		                      'W' 0xB9 1 1 0x02 0
		                      'W' 0x85 1 1 0x0B 0
		                      'W' 0xFD 1 1 0x00 0
		                      'W' 0x20 1 1 0x17 20
		                      'W' 0xFD 1 1 0x03 0
		                      'W' 0xBC 1 1 0x20 0
		                      'W' 0x88 1 1 0x00 0
		                      'W' 0x89 1 1 0x00 0
		                      'W' 0x8A 1 1 0x03 0
		                      'W' 0x8B 1 1 0xFF 0
		                      'W' 0x85 1 1 0x1B 0
		                      'W' 0xB7 1 1 0x80 0
		                      'W' 0x81 1 1 0x01 10
		                      'W' 0xFD 1 1 0x03 0
		                      'W' 0xB2 1 1 0x01 0
		                      'W' 0xFD 1 1 0x90 0
		                      'R' 0x00 1 1 20 0
							  >;
		//temperature_reg_config format: [operation, addr, addr_type, data_type, data/size, flag]
		//operation: 'W' for write, 'R' for read
		//addr_type: 1 for CAMERA_SENSOR_I2C_TYPE_BYTE
		//data_type: 1 for CAMERA_SENSOR_I2C_TYPE_BYTE
		//for write: data is the value to write, flag is delay(ms)
		//for read: data is the data size to read, flag: 0=normal, 1=integer part, 2=decimal part
		temperature_reg_config = <'W' 0xFD 1 1 0x0C 0
		                          'W' 0x12 1 1 0x01 0
		                          'R' 0x13 1 1 1 1
		                          'R' 0x14 1 1 1 2>;
		status = "ok";
	};
};

&qupv3_se9_i2c {
	status = "ok";
	qcom,high-perf;
	qcom,clk-freq-out = <1000000>;
	qcom,pm-ctrl-client;

	eeprom_front: qcom,eeprom1 {
		cell-index = <1>;
		reg = <0x54>;
		compatible = "qcom,cam-i2c-eeprom";
		cam_vio-supply = <&L5M>;
		cam_vana-supply = <&L6N>;
		cam_vdig-supply = <&L1M>;
		cam_vaf-supply = <&L5N>;
		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
		regulator-names = "cam_vio", "cam_vana", "cam_vdig", "cam_vaf", "cam_clk";
		rgltr-cntrl-support;
		rgltr-min-voltage = <1800000 2200000 1100000 2800000 0>;
		rgltr-max-voltage = <1800000 2200000 1100000 2800000 0>;
		rgltr-load-current = <3000 50000 50000 50000 0>;
		status = "ok";
	};

	actuator_front: qcom,actuator1 {
		cell-index = <1>;
		reg = <0x18>;
		compatible = "qcom,cam-i2c-actuator";
		cam_vio-supply = <&L5M>;
		cam_vana-supply = <&L6N>;
		cam_vdig-supply = <&L1M>;
		cam_vaf-supply = <&L5N>;
		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
		regulator-names = "cam_vio", "cam_vana", "cam_vdig", "cam_vaf", "cam_clk";
		rgltr-cntrl-support;
		rgltr-min-voltage = <1800000 2200000 1100000 2800000 0>;
		rgltr-max-voltage = <1800000 2200000 1100000 2800000 0>;
		rgltr-load-current = <3000 50000 50000 50000 0>;
		status = "ok";
	};

	//front sensor
	 qcom,cam-sensor1 {
		cell-index = <1>;
		reg = <0x20>;
		compatible = "qcom,cam-i2c-sensor";
		csiphy-sd-index = <4>;
		sensor-position-roll = <270>;
		sensor-position-pitch = <0>;
		sensor-position-yaw = <180>;
		eeprom-src = <&eeprom_front>;
		actuator-src = <&actuator_front>;
		aon-camera-id = <AON_CAM1>;
		cam_vio-supply = <&L5M>;
		cam_vana-supply = <&L6N>;
		cam_vdig-supply = <&L1M>;
		cam_vaf-supply = <&L5N>;
		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
		regulator-names = "cam_vio", "cam_vana", "cam_vdig", "cam_vaf", "cam_clk";
		rgltr-cntrl-support;
		rgltr-min-voltage = <1800000 2200000 1100000 2800000 0>;
		rgltr-max-voltage = <1800000 2200000 1100000 2800000 0>;
		rgltr-load-current = <3000 50000 50000 50000 0>;
		gpio-no-mux = <0>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_sensor_front_mclk4_active
				 &cam_sensor_front_active_rst4>;
		pinctrl-1 = <&cam_sensor_front_mclk4_suspend
				 &cam_sensor_front_suspend_rst4>;
		gpios = <&tlmm 93 0>,
			<&tlmm 7 0>;
		gpio-reset = <1>;
		gpio-req-tbl-num = <0 1>;
		gpio-req-tbl-flags = <1 0>;
		gpio-req-tbl-label = "CAMIF_MCLK4",
					"CAM_RESET4";
		clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK4_CLK>;
		clock-names = "cam_clk";
		clock-cntl-level = "nominal";
		clock-rates = <19200000>;
		is_support_advancedpowerup = <1>;
		//ftm_setting_compatible = <'R' 0x0016 2 2 0x0709>;
		status = "ok";
	};
};
