&soc {
	dsi_panel_XN253_P_3_A0040_dsc_cmd {
		qcom,dsi-display-active;
	};
};

&dsi_panel_XN253_P_3_A0040_dsc_cmd {
	qcom,panel-supply-entries = <&oplus_dsi_panel_custom_pwr_supply>;
	qcom,platform-te-gpio = <&tlmm 86 0>;
	qcom,platform-reset-gpio = <&tlmm 171 0>;
	/* DVDDP 1p3 enable */
	oplus,panel-gpio1 = <&pmh0101_gpios 4 0>;
	/* PMIC SGM3820 enable */
	oplus,panel-gpio2 = <&pmh0110_i_gpios 11 0>;

	oplus,panel-reset-position = <0x02>;
	oplus,panel-power-on-sequence = "1", "vddio", "3", "vdd", "3", "gpio1",  "vci", "5", "gpio2", "3";
	oplus,panel-power-off-sequence = "1", "gpio2", "3", "vci", "3", "gpio1", "0", "vdd", "3", "vddio", "1";


	/* BRIGHTNESS CONFIG */
	qcom,mdss-dsi-bl-pmic-control-type = "bl_ctrl_dcs";
	qcom,bl-update-flag = "delay_until_first_frame";
	qcom,mdss-dsi-bl-inverted-dbv;
	qcom,mdss-dsi-bl-min-level = <1>;
	qcom,mdss-dsi-bl-max-level = <4094>;
	qcom,mdss-brightness-max-level = <4094>;
	oplus,dsi-bl-normal-max-level = <3515>;
	oplus,dsi-brightness-normal-max-level = <3515>;
	oplus,dsi-dc-backlight-threshold = <1960>;
	oplus,dsi-brightness-default-level = <1638>;


	/* FACTORY CONFIG */
	oplus,mdss-dsi-vendor-name = "A0040";
	oplus,mdss-dsi-manufacture = "P_3";



	qcom,ulps-enabled;
	qcom,dsi-select-clocks = "pll_byte_clk0", "pll_dsi_clk0";

	qcom,mdss-dsi-display-timings {
		timing@sdc_fhd_120 { /* FHD+ 120hz 1112.6Mbps */
			qcom,mdss-dsi-panel-phy-timings = [00 38 0E 0E 20 1D 0E 0E 0D 02 04 00 2C 13];
			qcom,display-topology = <1 1 1>,<2 2 1>;
			qcom,default-topology-index = <1>;
		};
	};
};


