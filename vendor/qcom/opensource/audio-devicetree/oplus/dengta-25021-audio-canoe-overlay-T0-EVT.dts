/dts-v1/;
/plugin/;

#include <dt-bindings/oplus/hw-id.h>
#include "../canoe-audio-mtp.dts"

#include "canoe-audio-overlay-common.dtsi"
#include "dengta-25021-audio-canoe-overlay.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. Canoe MTP,dengta";

	oplus,project-id = <25021 25022 25211 25212>;
	oplus,hw-id = <OPLUS_PRE_T0 OPLUS_EVB1 OPLUS_EVB2 OPLUS_EVB3 OPLUS_T0 OPLUS_EVT1 OPLUS_EVT2>;
};

&qupv3_se0_i2c {
	tfa98xx@34 {
		tfa_fw_name = "tfa98xx_evt.cnt";
	};
	tfa98xx@35 {
		tfa_fw_name = "tfa98xx_evt.cnt";
	};
};
