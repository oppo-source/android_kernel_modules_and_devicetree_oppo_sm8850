				strategy_temp_little_cool_high = <4050 40 0 0 0
								 4050 35 0 0 0
								 4050 30 0 0 0
								 4150 27 0 0 0
								 4150 25 0 0 0
								 4150 20 0 0 0
								 4150 15 0 0 0
								 4550 10 1 0 0>;
				strategy_temp_normal_low =	<4030 91 0 120 0
