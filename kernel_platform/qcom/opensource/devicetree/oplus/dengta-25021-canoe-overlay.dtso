&qupv3_4{
    qupv3_se20_2uart: qcom,qup_uart@1a84000 {
 		compatible = "qcom,msm-geni-serial-hs";
 		reg = <0x1a84000 0x4000>;
 		reg-names = "se_phys";
 		interrupts = <GIC_SPI 857 IRQ_TYPE_LEVEL_HIGH>, <&tlmm 31 IRQ_TYPE_LEVEL_HIGH>;
        clock-names = "se-clk";
        clocks = <&gcc GCC_QUPV3_WRAP4_S1_CLK>;
 		interconnect-names = "qup-core", "qup-config", "qup-memory";
 		interconnects =
        <&clk_virt MASTER_QUP_CORE_4 &clk_virt SLAVE_QUP_CORE_4>,
        <&gem_noc MASTER_APPSS_PROC &config_noc SLAVE_QUP_4>,
        <&aggre2_noc MASTER_QUP_4 &mc_virt  SLAVE_EBI1>;
 		pinctrl-names = "active", "sleep","shutdown","default";
 		pinctrl-0 = <&qupv3_se20_2uart_tx_active>, <&qupv3_se20_2uart_rx_active>;
 		pinctrl-1 = <&qupv3_se20_2uart_sleep>;
        pinctrl-2 = <&qupv3_se20_2uart_sleep>;
        pinctrl-3 = <&qupv3_se20_2uart_sleep>;
 		qcom,wakeup-byte = <0xFD>;
		status = "ok";
 	};
};

&qupv3_1{
    qupv3_se6_2uart: qcom,qup_uart@a98000 {
 		compatible = "qcom,msm-geni-serial-hs";
 		reg = <0xa98000 0x4000>;
 		reg-names = "se_phys";
 		interrupts = <GIC_SPI 834 IRQ_TYPE_LEVEL_HIGH>, <&tlmm 59 IRQ_TYPE_LEVEL_HIGH>;
        clock-names = "se-clk";
        clocks = <&gcc GCC_QUPV3_WRAP1_S6_CLK>;
 		interconnect-names = "qup-core", "qup-config", "qup-memory";
 		interconnects =
        <&clk_virt MASTER_QUP_CORE_1 &clk_virt SLAVE_QUP_CORE_1>,
        <&gem_noc MASTER_APPSS_PROC &config_noc SLAVE_QUP_1>,
        <&aggre1_noc MASTER_QUP_1 &mc_virt  SLAVE_EBI1>;
 		pinctrl-names = "active", "sleep","shutdown","default";
 		pinctrl-0 = <&qupv3_se6_2uart_tx_active>, <&qupv3_se6_2uart_rx_active>;
 		pinctrl-1 = <&qupv3_se6_2uart_sleep>;
        pinctrl-2 = <&qupv3_se6_2uart_sleep>;
        pinctrl-3 = <&qupv3_se6_2uart_sleep>;
 		qcom,wakeup-byte = <0xFD>;
		status = "ok";
 	};
};


#include <dt-bindings/regulator/qcom,rpmh-regulator-levels.h>
&apps_rsc_drv2 {
    rpmh-regulator-l2f-e0 {
		compatible = "qcom,rpmh-vrm-regulator";
		qcom,resource-name = "L2F_E0";
		qcom,regulator-type = "pmic7-ldo";
		qcom,supported-modes = <RPMH_REGULATOR_MODE_LPM
					RPMH_REGULATOR_MODE_AUTO>;
		qcom,mode-threshold-currents = <0 30000>;

        L2F: L2F_E0: pmh0110_f_l2: regulator-pmh0110-f-l2 {
			regulator-name = "pmh0110_f_l2";
			qcom,set = <RPMH_REGULATOR_SET_ALL>;
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			qcom,init-voltage = <1800000>;
			qcom,init-mode = <RPMH_REGULATOR_MODE_AUTO>;
		};
	};

    rpmh-regulator-l8b-e0 {
 		compatible = "qcom,rpmh-vrm-regulator";
 		qcom,resource-name = "L8B_E0";
 		qcom,regulator-type = "pmic7-ldo";
 		qcom,supported-modes = <RPMH_REGULATOR_MODE_LPM
 					RPMH_REGULATOR_MODE_AUTO>;
 		qcom,mode-threshold-currents = <0 10000>;
 
 		L8B: L8B_E0: pmh0101_l8: regulator-pmh0101-l8 {
 			regulator-name = "pmh0101_l8";
 			qcom,set = <RPMH_REGULATOR_SET_ALL>;
 			regulator-min-microvolt = <2800000>;
 			regulator-max-microvolt = <2800000>;
 			qcom,init-voltage = <2800000>;
 			qcom,init-mode = <RPMH_REGULATOR_MODE_AUTO>;
 		};
 	};
 	rpmh-regulator-l14b-e0 {
 		compatible = "qcom,rpmh-vrm-regulator";
 		qcom,resource-name = "L14B_E0";
 		qcom,regulator-type = "pmic7-ldo";
 		qcom,supported-modes = <RPMH_REGULATOR_MODE_LPM
 					RPMH_REGULATOR_MODE_AUTO>;
 		qcom,mode-threshold-currents = <0 10000>;
 
 		L14B: L14B_E0: pmh0101_l14: regulator-pmh0101-l14 {
 			regulator-name = "pmh0101_l14";
 			qcom,set = <RPMH_REGULATOR_SET_ALL>;
 			regulator-min-microvolt = <2800000>;
 			regulator-max-microvolt = <2800000>;
 			qcom,init-voltage = <2800000>;
 			qcom,init-mode = <RPMH_REGULATOR_MODE_AUTO>;
 		};
 	};
    rpmh-regulator-l4i-e0 {
 		compatible = "qcom,rpmh-vrm-regulator";
 		qcom,resource-name = "L4I_E0";
 		qcom,regulator-type = "pmic7-ldo";
 		qcom,supported-modes = <RPMH_REGULATOR_MODE_LPM
 					RPMH_REGULATOR_MODE_AUTO>;
 		qcom,mode-threshold-currents = <0 30000>;
 
 		L4I: L4I_E0: pmh0110_i_l4: regulator-pmh0110-i-l4 {
 			regulator-name = "pmh0110_i_l4";
 			qcom,set = <RPMH_REGULATOR_SET_ALL>;
 			regulator-min-microvolt = <800000>;
 			regulator-max-microvolt = <800000>;
 			qcom,init-voltage = <800000>;
 			qcom,init-mode = <RPMH_REGULATOR_MODE_AUTO>;
 		};
 	};

};

&aliases{
    hsuart3	= "/soc/qcom,qupv3_4_geni_se@1ac0000/qcom,qup_uart@1a84000";
    hsuart4	= "/soc/qcom,qupv3_1_geni_se@ac0000/qcom,qup_uart@a98000";
};
